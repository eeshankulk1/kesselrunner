#!/usr/bin/env node
// A fake gh for the merge-queue tests: PRs, their checks and merges, against the sandbox's bare origin
// (FAKE_GH_ORIGIN), with its state in a JSON file (FAKE_GH_STATE). Like GitHub, a merge marks every other
// open PR whose head is now in the base branch merged too.
//   state: { next, prs: [{ number, headRefName, baseRefName, state, title, body, isDraft, mergeCommit, comments }],
//            ci: [{ name, failIfFiles?: [paths], failIfGrep?: regex, paths?: [pathspecs], pending?: true,
//                   status?: true (a passing commit status, like an attest's), late?: ms (no check run until that long
//                   after a head is first viewed), required?: true (branch protection: BLOCKED until it passes) }],
//            lag?: ms (GitHub behind itself: pr view shows each PR as it stood that long ago, a new PR is not there yet,
//                 and a merge is refused until the head it names has shown), failView?: text (pr view fails with it),
//            annotations?: { <job id>: [{ message }] }, reruns: { <run id>: n }, calls: [argv...],
//            failGraphql?: text (api graphql fails with it), upToDate?: true (branch protection: a PR must hold its base),
//            failMerge?: text (the next pr merge fails with it, once),
//            logs?: { <run id>: text } (run view <id> --log-failed),
//            merged?: { checkRuns: [{ name, status, conclusion, check_suite?: { id } }], statuses: [{ context, state }], deployments: [{ id, environment, state, url }] }
//              (what a merge commit started, as the ship script's after-merge runner reads it through gh api),
//            rules?: [names] (required checks from a ruleset; ci[].required ones come from branch protection),
//            dispatch?: { <workflow>: { conclusion, polls?: n (in progress for the first n views), noLink?: true (an older gh) } },
//            runs?: [{ databaseId, workflow, branch, views, conclusion, fields }] (what workflow run started) }
//   A PR's review threads: pr.threads = [{ id, isResolved, isOutdated, path, line, comments: [{ author: { login, __typename }, body, url, createdAt }] }];
//   api graphql answers the reviewThreads query and the addPullRequestReviewThreadReply / resolveReviewThread mutations.
// A check runs forever (pending: true, or pendingIfFiles: every file exists at the PR's head).
// A check fails when every file in failIfFiles exists at the PR's head, or failIfGrep matches there.
import { execFileSync, spawnSync } from "node:child_process";
import { readFileSync, writeFileSync } from "node:fs";

const STATE = process.env.FAKE_GH_STATE;
const ORIGIN = process.env.FAKE_GH_ORIGIN;
const URL = "https://github.com/t/repo";
const s = JSON.parse(readFileSync(STATE, "utf8"));
s.calls ??= [];
s.reruns ??= {};
s.seen ??= {};
s.history ??= {};
const argv = process.argv.slice(2);
s.calls.push(argv);
const save = () => writeFileSync(STATE, JSON.stringify(s, null, 2));
const git = (...args) => execFileSync("git", ["-C", ORIGIN, ...args], { encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] }).trim();
const gitOk = (...args) => spawnSync("git", ["-C", ORIGIN, ...args], { stdio: "ignore" }).status === 0;
const die = (msg, code = 1) => { save(); process.stderr.write(`${msg}\n`); process.exit(code); };
const opt = (name) => { const i = argv.indexOf(name); return i >= 0 ? argv[i + 1] : undefined; };
const has = (name) => argv.includes(name);
const head = (pr) => (gitOk("rev-parse", "--verify", "-q", `refs/heads/${pr.headRefName}`) ? git("rev-parse", `refs/heads/${pr.headRefName}`) : pr.lastHead ?? null);

function find(ref) {
  const n = Number(String(ref).replace(/^.*\/pull\//, ""));
  if (n) return s.prs.find((p) => p.number === n);
  return s.prs.filter((p) => p.headRefName === ref).sort((a, b) => (a.state === "OPEN") - (b.state === "OPEN") || a.number - b.number).pop();
}

function checks(pr, sha = head(pr)) {
  if (!sha) return [];
  s.seen[sha] ??= Date.now();
  return (s.ci ?? []).flatMap((c, i) => {
    if (c.status) return { __typename: "StatusContext", context: c.name, state: "SUCCESS", targetUrl: null };
    if (c.late && Date.now() - s.seen[sha] < c.late) return [];
    const run = 100 + i;
    const link = `${URL}/actions/runs/${run}/job/1`;
    if (c.pending || (Array.isArray(c.pendingIfFiles) && c.pendingIfFiles.every((f) => gitOk("cat-file", "-e", `${sha}:${f}`)))) return { __typename: "CheckRun", name: c.name, status: "IN_PROGRESS", conclusion: "", detailsUrl: link };
    const byFiles = Array.isArray(c.failIfFiles) && c.failIfFiles.every((f) => gitOk("cat-file", "-e", `${sha}:${f}`));
    const byGrep = c.failIfGrep && gitOk("grep", "-q", "-E", c.failIfGrep, sha, "--", ...(c.paths ?? []));
    return { __typename: "CheckRun", name: c.name, status: "COMPLETED", conclusion: byFiles || byGrep ? "FAILURE" : "SUCCESS", detailsUrl: link };
  });
}

/** Branch protection that wants the branch up to date (s.upToDate): an open PR whose head lacks its base is behind. */
const behind = (pr, sha = head(pr)) => !!s.upToDate && pr.state === "OPEN" && !gitOk("merge-base", "--is-ancestor", `refs/heads/${pr.baseRefName}`, sha);
const blocked = (pr, sha = head(pr)) => (s.ci ?? []).some((c) => c.required && !checks(pr, sha).some((x) => x.name === c.name && x.conclusion === "SUCCESS"));

/** Every field as it stands now, kept each time it changes: what a view shows is the last one `lag` old. */
function current(pr) {
  const sha = head(pr);
  const all = {
    number: pr.number, state: pr.state, isDraft: !!pr.isDraft, headRefName: pr.headRefName, headRefOid: sha, baseRefName: pr.baseRefName,
    url: `${URL}/pull/${pr.number}`, title: pr.title, body: pr.body ?? "", statusCheckRollup: pr.state === "OPEN" ? checks(pr, sha) : [],
    mergeCommit: pr.mergeCommit ? { oid: pr.mergeCommit } : null, mergeStateStatus: blocked(pr, sha) ? "BLOCKED" : behind(pr, sha) ? "BEHIND" : "CLEAN",
  };
  const seen = (s.history[pr.number] ??= []);
  if (JSON.stringify(seen.at(-1)?.all) !== JSON.stringify(all)) seen.push({ at: Date.now(), all });
  return seen;
}

function view(pr, fields) {
  const seen = current(pr);
  const shown = seen.findLast((x) => !s.lag || Date.now() - x.at >= s.lag)?.all ?? seen[0].all;
  return Object.fromEntries(fields.split(",").map((f) => [f, shown[f]]));
}

const [group, cmd, ref] = argv;
if (group === "pr" && cmd === "view") {
  if (s.failView) die(s.failView);
  const pr = find(ref);
  if (!pr || (s.lag && Date.now() - pr.at < s.lag)) die(`no pull requests found for branch "${ref}"`);
  process.stdout.write(JSON.stringify(view(pr, opt("--json"))));
} else if (group === "pr" && cmd === "list") {
  const state = (opt("--state") ?? "open").toUpperCase();
  process.stdout.write(JSON.stringify(s.prs.filter((p) => state === "ALL" || p.state === state).map((p) => view(p, opt("--json")))));
} else if (group === "pr" && cmd === "create") {
  const branch = opt("--head");
  if (!gitOk("rev-parse", "--verify", "-q", `refs/heads/${branch}`)) die(`head branch "${branch}" not found`);
  const pr = { number: s.next++, headRefName: branch, baseRefName: opt("--base") ?? "main", state: "OPEN", title: opt("--title") ?? branch, body: opt("--body") ?? "", isDraft: has("--draft"), at: s.lag ? Date.now() : 0 };
  s.prs.push(pr);
  process.stdout.write(`${URL}/pull/${pr.number}\n`);
} else if (group === "pr" && cmd === "merge") {
  if (s.failMerge) { const text = s.failMerge; delete s.failMerge; die(text); }
  const pr = find(ref);
  if (!pr || pr.state !== "OPEN") die("pull request is not open");
  const sha = head(pr);
  const want = opt("--match-head-commit");
  if (want && want !== sha) die("head branch was modified");
  if (s.lag && view(pr, "headRefOid").headRefOid !== sha) die("GraphQL: Head branch was modified. Review and try the merge again. (mergePullRequest)");
  if (blocked(pr) || behind(pr)) die(`X Pull request t/repo#${pr.number} is not mergeable: the base branch policy prohibits the merge.`);
  const baseRef = `refs/heads/${pr.baseRefName}`;
  const base = git("rev-parse", baseRef);
  const mt = spawnSync("git", ["-C", ORIGIN, "merge-tree", "--write-tree", base, sha], { encoding: "utf8" });
  if (mt.status !== 0) die("Pull request is not mergeable: the merge commit cannot be cleanly created.");
  const tree = mt.stdout.split("\n")[0].trim();
  const parents = has("--squash") ? ["-p", base] : ["-p", base, "-p", sha];
  const msg = has("--squash") ? `${pr.title} (#${pr.number})` : `Merge pull request #${pr.number} from t/${pr.headRefName}`;
  const commit = git("commit-tree", tree, ...parents, "-m", msg);
  git("update-ref", baseRef, commit, base);
  Object.assign(pr, { state: "MERGED", mergeCommit: commit, lastHead: sha });
  for (const other of s.prs) {
    const h = other.state === "OPEN" && other.baseRefName === pr.baseRefName ? head(other) : null;
    if (h && gitOk("merge-base", "--is-ancestor", h, commit)) Object.assign(other, { state: "MERGED", mergeCommit: commit, lastHead: h });
  }
  if (has("--delete-branch")) git("update-ref", "-d", `refs/heads/${pr.headRefName}`);
} else if (group === "pr" && cmd === "close") {
  const pr = find(ref);
  if (!pr) die("no such pull request");
  pr.lastHead = head(pr);
  pr.state = "CLOSED";
  if (has("--delete-branch") && gitOk("rev-parse", "--verify", "-q", `refs/heads/${pr.headRefName}`)) git("update-ref", "-d", `refs/heads/${pr.headRefName}`);
} else if (group === "pr" && cmd === "comment") {
  const pr = find(ref);
  if (!pr) die("no such pull request");
  (pr.comments ??= []).push(opt("--body") ?? "");
} else if (group === "api" && cmd === "graphql") {
  if (s.failGraphql) die(s.failGraphql);
  const f = {};
  for (let i = 2; i < argv.length - 1; i++) if (argv[i] === "-f" || argv[i] === "-F") { const [k, ...v] = argv[++i].split("="); f[k] = v.join("="); }
  const all = s.prs.flatMap((p) => (p.threads ?? []).map((t) => ({ p, t })));
  const thread = (id) => all.find((x) => x.t.id === id)?.t ?? die(`GraphQL: Could not resolve to a node with the global id of '${id}'`);
  let data;
  if (/reviewThreads/.test(f.query)) {
    if (f.owner !== "{owner}" || f.name !== "{repo}") die(`fake gh: expected gh's placeholders, got ${f.owner}/${f.name}`);
    const pr = find(f.number);
    data = { repository: { pullRequest: pr ? { reviewThreads: { pageInfo: { hasNextPage: false, endCursor: null }, nodes: (pr.threads ?? []).map((t) => ({ ...t, comments: { nodes: t.comments ?? [] } })) } } : null } };
  } else if (/addPullRequestReviewThreadReply/.test(f.query)) {
    const t = thread(f.id);
    const url = `${URL}/pull/1#discussion_r${(t.comments ??= []).length + 1000}`;
    t.comments.push({ author: { login: "me", __typename: "User" }, body: f.body, url, createdAt: new Date().toISOString() });
    data = { addPullRequestReviewThreadReply: { comment: { url } } };
  } else if (/resolveReviewThread/.test(f.query)) {
    const t = thread(f.id);
    t.isResolved = true;
    data = { resolveReviewThread: { thread: { id: t.id, isResolved: true } } };
  } else die(`fake gh: unsupported graphql: ${f.query}`, 2);
  process.stdout.write(JSON.stringify({ data }));
} else if (group === "api" && /\/check-runs\/(\d+)\/annotations$/.test(cmd)) {
  process.stdout.write(JSON.stringify(s.annotations?.[/\/check-runs\/(\d+)\//.exec(cmd)[1]] ?? []));
} else if (group === "pr" && cmd === "edit") {
  const pr = find(ref);
  if (!pr) die("no such pull request");
  if (opt("--body") !== undefined) pr.body = opt("--body");
} else if (group === "run" && cmd === "view" && has("--log-failed")) {
  if (s.logs?.[ref] === undefined) die(`run ${ref} not found`);
  process.stdout.write(s.logs[ref]);
} else if (group === "api" && /\/commits\/[0-9a-f]+\/check-runs/.test(cmd)) {
  process.stdout.write(JSON.stringify({ total_count: (s.merged?.checkRuns ?? []).length, check_runs: (s.merged?.checkRuns ?? []).map((r) => ({ details_url: null, ...r })) }));
} else if (group === "api" && /\/commits\/[0-9a-f]+\/status$/.test(cmd)) {
  process.stdout.write(JSON.stringify({ state: "success", statuses: s.merged?.statuses ?? [] }));
} else if (group === "api" && /\/deployments\?sha=/.test(cmd)) {
  process.stdout.write(JSON.stringify((s.merged?.deployments ?? []).map((d) => ({ id: d.id, environment: d.environment }))));
} else if (group === "api" && /\/deployments\/(\d+)\/statuses/.test(cmd)) {
  const d = (s.merged?.deployments ?? []).find((x) => String(x.id) === /\/deployments\/(\d+)\//.exec(cmd)[1]);
  process.stdout.write(JSON.stringify(d ? [{ state: d.state, environment_url: d.url ?? null, log_url: null }] : []));
} else if (group === "api" && /\/rules\/branches\//.test(cmd)) {
  process.stdout.write(JSON.stringify(s.rules?.length ? [{ type: "required_status_checks", parameters: { required_status_checks: s.rules.map((context) => ({ context })) } }] : []));
} else if (group === "api" && /\/branches\/[^/]+$/.test(cmd)) {
  const contexts = (s.ci ?? []).filter((c) => c.required).map((c) => c.name);
  process.stdout.write(JSON.stringify({ name: cmd.split("/").pop(), protected: contexts.length > 0, protection: { enabled: contexts.length > 0, required_status_checks: { contexts, checks: contexts.map((context) => ({ context })) } } }));
} else if (group === "workflow" && cmd === "run") {
  const d = s.dispatch?.[ref];
  if (!d) die(`could not find any workflows named ${ref}`);
  const fields = argv.flatMap((a, i) => (argv[i - 1] === "-f" ? [a] : []));
  const run = { databaseId: 5000 + (s.runs ??= []).length, workflow: ref, branch: opt("--ref") ?? "main", views: 0, conclusion: d.conclusion, polls: d.polls ?? 0, fields };
  s.runs.push(run);
  if (!d.noLink) process.stdout.write(`${URL}/actions/runs/${run.databaseId}\n`);
} else if (group === "run" && cmd === "list") {
  const runs = (s.runs ?? []).filter((r) => r.workflow === opt("--workflow") && (!opt("--branch") || r.branch === opt("--branch")));
  process.stdout.write(JSON.stringify(runs.reverse().map((r) => ({ databaseId: r.databaseId }))));
} else if (group === "run" && cmd === "view" && opt("--json")) {
  const run = (s.runs ?? []).find((r) => String(r.databaseId) === ref);
  if (!run) die(`run ${ref} not found`);
  const done = ++run.views > run.polls;
  process.stdout.write(JSON.stringify({ status: done ? "completed" : "in_progress", conclusion: done ? run.conclusion : "", url: `${URL}/actions/runs/${run.databaseId}` }));
} else if (group === "run" && cmd === "rerun") {
  s.reruns[ref] = (s.reruns[ref] ?? 0) + 1;
} else {
  die(`fake gh: unsupported: ${argv.join(" ")}`, 2);
}
save();
